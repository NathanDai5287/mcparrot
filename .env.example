BROWSER_USE_API_KEY=
CURSOR_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional; when set, these override KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Encrypts saved logins. Generate with: openssl rand -base64 32
MCPARROT_CREDENTIAL_KEY=
# Sentry project DSN for error reporting.
NEXT_PUBLIC_SENTRY_DSN=
# Uploads source maps to Sentry during builds.
SENTRY_AUTH_TOKEN=
# Provided by Vercel when Protection Bypass for Automation is on; the owner's older ChatGPT links still use it.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Clerk sign-in keys, added by the Clerk integration from the Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The owner's Google email; only this account can use ordering and receives the older workspace.
MCPARROT_OWNER_EMAIL=
