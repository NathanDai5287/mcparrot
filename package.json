{
  "name": "mcparrot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "browser": "node --env-file-if-exists=.env browser.mjs",
    "check": "node --check browser.mjs && node --check public/extension/background.js && node --check public/extension/bridge.js && node scripts/check-extension-zip.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.17",
    "@cursor/sdk": "^1.0.38",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sentry/nextjs": "^11.8.0",
    "@upstash/redis": "^1.39.0",
    "browser-use-sdk": "^3.12.1",
    "next": "^16.4.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
