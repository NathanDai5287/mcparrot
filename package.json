{
  "name": "mcparrot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "browser": "node --env-file-if-exists=.env browser.mjs",
    "browser:local": "node browser-local.mjs",
    "check": "node --check browser.mjs && node --check browser-local.mjs && node --check local-auth-server.mjs && node --check teaching-worker.mjs && next typegen && tsc --noEmit",
    "browser:signin": "node local-auth-server.mjs",
    "browser:teach": "node teaching-worker.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "^3.8.0",
    "browser-use-sdk": "^3.12.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
