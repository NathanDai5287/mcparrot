{
  "name": "mcparrot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "browser": "node --env-file-if-exists=.env browser.mjs",
    "check": "node --check browser.mjs && node --check public/extension/background.js && node --check public/extension/bridge.js && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.38",
    "browser-use-sdk": "^3.12.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
